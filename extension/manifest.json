{
  "manifest_version": 3,
  "name": "Auto Tutorial Recorder",
  "version": "0.1.0",
  "description": "录制网页操作，自动生成图文教程",
  "permissions": ["tabs", "downloads", "storage", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "开始 / 结束录制"
  }
}
